{
  "manifest_version": 3,
  "name": "Mini AI QA Bubble",
  "version": "2.6.0",
  "description": "Bong bóng AI mini: chọn provider → model → token, tự dò model mới, bôi đen để hỏi ngay tại chỗ.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://api.mistral.ai/*",
    "https://integrate.api.nvidia.com/*",
    "https://ollama.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.sambanova.ai/*",
    "https://opencode.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mini AI QA Bubble",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-bubble.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "MacCtrl+Shift+G"
      },
      "description": "Mở Gemini popup"
    },
    "toggle-bubble": {
      "suggested_key": {
        "default": "Alt+G",
        "mac": "MacCtrl+Shift+G"
      },
      "description": "Mở Gemini popup (dự phòng, dùng trên Linux)"
    }
  }
}
